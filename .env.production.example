# Copy this file to .env.production and replace every non-secret CHANGE_ME_* value before deploying.
# Secrets should be created in Docker and referenced through *_FILE variables below.

DOMAIN=CHANGE_ME_DOMAIN
ACME_EMAIL=CHANGE_ME_EMAIL@example.com
# Start with Let's Encrypt staging, then switch to production after DNS and routing work.
TRAEFIK_ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
HTTP_PORT=80
HTTPS_PORT=443
ENV=production
BACKEND_PORT=8080
BACKEND_THREADS=4
CORS_ENABLED=true
CORS_ALLOW_ORIGINS=https://CHANGE_ME_DOMAIN
MODEL_SERVICE_PORT=8081
MODEL_PATH=/app/models/Z-Image-Turbo
MODEL_SERVICE_ALLOW_ORIGINS=https://CHANGE_ME_DOMAIN
MODEL_SERVICE_LOG_DIR=/app/logs
MODEL_SERVICE_TEMP_DIR=/app/temp
MODEL_SERVICE_MAX_CONCURRENT_GENERATIONS=1
MODEL_SERVICE_BUSY_UNHEALTHY_SECONDS=60
MODEL_SERVICE_TEMP_FILE_MAX_AGE_HOURS=24
MODEL_SERVICE_TEMP_FILE_CLEANUP_INTERVAL_SECONDS=3600

MYSQL_ROOT_PASSWORD_FILE=/run/secrets/mysql_root_password
MYSQL_BINLOG_EXPIRE_SECONDS=1209600
DB_USERNAME=app
DB_PASSWORD_FILE=/run/secrets/db_password
DB_NAME=image_generator

JWT_SECRET_FILE=/run/secrets/jwt_secret
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD_FILE=/run/secrets/minio_password
MINIO_SECRET_KEY_FILE=/run/secrets/minio_password
MINIO_BUCKET=zimage
MINIO_REGION=us-east-1

MYSQL_BACKUP_USER=root
MYSQL_BACKUP_PASSWORD_FILE=/run/secrets/mysql_root_password
MYSQL_BACKUP_TIME_UTC=02:00
MYSQL_BACKUP_RETENTION_DAYS=7
MYSQL_BACKUP_RUN_ONCE=false
MYSQL_BACKUP_RUN_IMMEDIATELY=false
MINIO_MIRROR_TIME_UTC=03:00
MINIO_MIRROR_RUN_ONCE=false
MINIO_MIRROR_RUN_IMMEDIATELY=false
BACKUP_S3_ENDPOINT=https://CHANGE_ME_S3_ENDPOINT
BACKUP_S3_BUCKET=CHANGE_ME_BACKUP_BUCKET
BACKUP_S3_ACCESS_KEY_FILE=/run/secrets/backup_s3_access_key
BACKUP_S3_SECRET_KEY_FILE=/run/secrets/backup_s3_secret_key
BACKUP_S3_PREFIX=zimage
BACKUP_S3_RETENTION_DAYS=30
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD_FILE=/run/secrets/grafana_admin_password

REDIS_ENABLED=true
REDIS_PASSWORD_FILE=/run/secrets/redis_password
REDIS_DB=0
REDIS_POOL_SIZE=4
REDIS_CONNECT_TIMEOUT_MS=1000
REDIS_SOCKET_TIMEOUT_MS=5000
REDIS_TASK_QUEUE_KEY=zimage:task_queue
REDIS_LEASE_KEY_PREFIX=zimage:lease:

CACHE_ENABLED=true
CACHE_HOST=redis
CACHE_PORT=6379
CACHE_PASSWORD_FILE=/run/secrets/redis_password
CACHE_DB=1
CACHE_POOL_SIZE=4
CACHE_CONNECT_TIMEOUT_MS=1000
CACHE_SOCKET_TIMEOUT_MS=500
CACHE_KEY_PREFIX=zimage:
CACHE_VERSION_KEY_TTL_SECONDS=86400

RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_OPEN=true
RATE_LIMIT_TRUST_PROXY=true
RATE_LIMIT_MAX_ACTIVE_TASKS_PER_USER=3
RATE_LIMIT_USER_CREATE_CAPACITY=10
RATE_LIMIT_USER_CREATE_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_IP_CAPACITY=5
RATE_LIMIT_AUTH_IP_WINDOW_SECONDS=60
RATE_LIMIT_KEY_PREFIX=zimage:rate:

TASK_ENGINE_WORKERS=2
TASK_ENGINE_POLL_INTERVAL_MS=500
TASK_ENGINE_LEASE_SECONDS=600
TASK_ENGINE_MAX_RETRIES=3
TASK_ENGINE_WORKER_PREFIX=backend-worker

BACKEND_REPLICAS=2
FRONTEND_REPLICAS=2
MODEL_SERVICE_REPLICAS=1

JWT_SECRET_NAME=zimage_jwt_secret
DB_PASSWORD_SECRET_NAME=zimage_db_password
MYSQL_ROOT_PASSWORD_SECRET_NAME=zimage_mysql_root_password
REDIS_PASSWORD_SECRET_NAME=zimage_redis_password
MINIO_PASSWORD_SECRET_NAME=zimage_minio_password
BACKUP_S3_ACCESS_KEY_SECRET_NAME=zimage_backup_s3_access_key
BACKUP_S3_SECRET_KEY_SECRET_NAME=zimage_backup_s3_secret_key
GRAFANA_ADMIN_PASSWORD_SECRET_NAME=zimage_grafana_admin_password

BACKEND_CPUS=2.0
BACKEND_MEM_LIMIT=1g
FRONTEND_CPUS=0.50
FRONTEND_MEM_LIMIT=256m
TRAEFIK_CPUS=0.25
TRAEFIK_MEM_LIMIT=128m
MODEL_SERVICE_CPUS=4.0
MODEL_SERVICE_MEM_LIMIT=12g
MYSQL_CPUS=2.0
MYSQL_MEM_LIMIT=2g
REDIS_CPUS=0.50
REDIS_MEM_LIMIT=256m
MINIO_CPUS=1.0
MINIO_MEM_LIMIT=512m

LOG_MAX_SIZE=10m
LOG_MAX_FILE=5
