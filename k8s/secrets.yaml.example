# Example only. Do not apply this file with real plaintext values.
# Recommended Sealed Secrets flow:
#   kubectl create secret generic zimage-secrets \
#     --from-literal=jwt_secret='...' \
#     --from-literal=db_password='...' \
#     --from-literal=redis_password='...' \
#     --from-literal=minio_password='...' \
#     --dry-run=client -o yaml | kubeseal -o yaml > k8s/sealed-secrets.yaml
# Commit only the sealed output, never a real plaintext Secret manifest.
apiVersion: v1
kind: Secret
metadata:
  name: zimage-secrets
type: Opaque
stringData:
  jwt_secret: CHANGE_ME_JWT_SECRET
  db_password: CHANGE_ME_DB_PASSWORD
  mysql_root_password: CHANGE_ME_MYSQL_ROOT_PASSWORD
  redis_password: CHANGE_ME_REDIS_PASSWORD
  minio_password: CHANGE_ME_MINIO_PASSWORD
  backup_s3_access_key: CHANGE_ME_BACKUP_ACCESS_KEY
  backup_s3_secret_key: CHANGE_ME_BACKUP_SECRET_KEY
  grafana_admin_password: CHANGE_ME_GRAFANA_PASSWORD
