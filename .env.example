MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
MYSQL_SQL_HOST_PORT=3306
MYSQL_X_HOST_PORT=33060
MYSQL_BINLOG_EXPIRE_SECONDS=1209600
FRONTEND_PORT=80
ENV=development

BACKEND_PORT=8080
BACKEND_THREADS=4
CORS_ENABLED=true
CORS_ALLOW_ORIGINS=http://localhost:3000

DB_HOST=mysql
DB_PORT=33060
DB_USERNAME=app
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
# Optional file-backed alternative for Docker secrets or local secret files.
# DB_PASSWORD_FILE=
DB_NAME=image_generator

JWT_SECRET=CHANGE_ME_JWT_SECRET
# JWT_SECRET_FILE=
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

PYTHON_SERVICE_URL=http://model-service:8081
PYTHON_SERVICE_TIMEOUT_SECONDS=360

TASK_ENGINE_WORKERS=2
TASK_ENGINE_POLL_INTERVAL_MS=500
TASK_ENGINE_LEASE_SECONDS=600
TASK_ENGINE_MAX_RETRIES=3
TASK_ENGINE_WORKER_PREFIX=backend-worker

STORAGE_ROOT_DIR=/app/storage/images
STORAGE_PUBLIC_URL_PREFIX=/api/images
STORAGE_EXTENSION=png

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
# MINIO_SECRET_KEY_FILE=
MINIO_BUCKET=zimage
REDIS_HOST_PORT=6379
REDIS_ENABLED=true
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
# REDIS_PASSWORD_FILE=
REDIS_DB=0
REDIS_POOL_SIZE=4
REDIS_CONNECT_TIMEOUT_MS=1000
REDIS_SOCKET_TIMEOUT_MS=5000
REDIS_TASK_QUEUE_KEY=zimage:task_queue
REDIS_LEASE_KEY_PREFIX=zimage:lease:

CACHE_ENABLED=true
CACHE_HOST=redis
CACHE_PORT=6379
CACHE_PASSWORD=CHANGE_ME_REDIS_PASSWORD
# CACHE_PASSWORD_FILE=
CACHE_DB=1
CACHE_POOL_SIZE=4
CACHE_CONNECT_TIMEOUT_MS=1000
CACHE_SOCKET_TIMEOUT_MS=500
CACHE_KEY_PREFIX=zimage:
CACHE_VERSION_KEY_TTL_SECONDS=86400

RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_OPEN=true
RATE_LIMIT_TRUST_PROXY=false
RATE_LIMIT_MAX_ACTIVE_TASKS_PER_USER=3
RATE_LIMIT_USER_CREATE_CAPACITY=10
RATE_LIMIT_USER_CREATE_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_IP_CAPACITY=5
RATE_LIMIT_AUTH_IP_WINDOW_SECONDS=60
RATE_LIMIT_KEY_PREFIX=zimage:rate:

MODEL_SERVICE_PORT=8081
MODEL_PATH=/app/models/Z-Image-Turbo
MODEL_SERVICE_ALLOW_ORIGINS=*
MODEL_SERVICE_LOG_DIR=/app/logs
MODEL_SERVICE_TEMP_DIR=/app/temp
MODEL_SERVICE_MAX_CONCURRENT_GENERATIONS=1
MODEL_SERVICE_BUSY_UNHEALTHY_SECONDS=60
MODEL_SERVICE_TEMP_FILE_MAX_AGE_HOURS=24
MODEL_SERVICE_TEMP_FILE_CLEANUP_INTERVAL_SECONDS=3600

# Vite dev proxy defaults to http://127.0.0.1:${BACKEND_PORT}.
# Put VITE_BACKEND_PROXY_TARGET / VITE_HEALTH_PROXY_TARGET overrides in
# ZImageFrontend/.env.local or shell environment variables when needed.
